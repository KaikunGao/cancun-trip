rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberOf(tripId) {
      return signedIn() && myEmail() in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
    }

    // 一份行程：members 是成员邮箱列表（小写），只有成员能读写
    match /trips/{tripId} {
      allow get: if signedIn() && myEmail() in resource.data.members;
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && myEmail() in request.resource.data.members
                    && request.resource.data.members.size() <= 10;
      allow update: if signedIn()
                    && myEmail() in resource.data.members
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.members.size() <= 10;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /days/{day} {
        allow read, write: if memberOf(tripId);
      }
      match /presence/{uid} {
        allow read: if memberOf(tripId);
        allow write: if memberOf(tripId) && request.auth.uid == uid;
      }
    }

    // invites/<邮箱>：这个邮箱被加进了哪些行程。只是索引，能不能打开行程仍由 trips 的 members 决定
    match /invites/{email} {
      allow get: if signedIn() && myEmail() == email;
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['trips'])
                    && request.resource.data.trips is list
                    && request.resource.data.trips.size() <= 50;
      allow update: if signedIn()
                    && request.resource.data.keys().hasOnly(['trips'])
                    && request.resource.data.trips is list
                    && request.resource.data.trips.size() <= 50
                    && request.resource.data.trips.hasAll(resource.data.trips);
      allow delete: if false;
    }
  }
}
